# ═══════════════════════════════════════════════════════════════════════════════
# AMEND Protocol v0.1.1 - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in all required values
# 3. NEVER commit .env to version control
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# RPC ENDPOINTS
# ─────────────────────────────────────────────────────────────────────────────────

# Base Sepolia (Testnet)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Base Mainnet
BASE_MAINNET_RPC=https://mainnet.base.org

# Local Development (Anvil)
LOCAL_RPC=http://127.0.0.1:8545

# ─────────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT KEYS (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────────

# Deployer private key (WITHOUT 0x prefix)
# ⚠️  NEVER commit real private keys!
# For testnet: Use a dedicated testnet wallet
# For mainnet: Use hardware wallet via cast wallet
PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# PROTOCOL CONFIGURATION (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────────

# Admin address - Will have ADMIN_ROLE on Engine
# ⚠️  For mainnet: Use a multisig wallet (e.g., Safe)
ADMIN_ADDRESS=

# Fee recipient - Treasury address that receives protocol fees
# ⚠️  For mainnet: Use a multisig wallet
FEE_RECIPIENT=

# Fee in basis points (100 = 1%, 1000 = 10%, max 2000 = 20%)
FEE_BPS=1000

# ─────────────────────────────────────────────────────────────────────────────────
# TOKEN ADDRESSES (OPTIONAL - uses defaults per network)
# ─────────────────────────────────────────────────────────────────────────────────

# Override USDC address (leave empty to use network default)
# Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────────
# CONTRACT VERIFICATION
# ─────────────────────────────────────────────────────────────────────────────────

# BaseScan API key for contract verification
# Get yours at: https://basescan.org/apis
BASESCAN_API_KEY=

# Etherscan API key (for other networks)
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# POST-DEPLOYMENT VERIFICATION
# ─────────────────────────────────────────────────────────────────────────────────

# Deployed contract addresses (fill after deployment)
VAULT_ADDRESS=
ENGINE_ADDRESS=

# Addresses to verify roles (optional)
MANAGER_ADDRESS=
REPORTER_ADDRESS=

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT COMMANDS
# ═══════════════════════════════════════════════════════════════════════════════
#
# Testnet deployment:
#   source .env
#   forge script script/Deploy.s.sol:DeployTestnet \
#     --rpc-url $BASE_SEPOLIA_RPC \
#     --broadcast \
#     --verify \
#     --etherscan-api-key $BASESCAN_API_KEY
#
# Mainnet deployment:
#   source .env
#   forge script script/Deploy.s.sol:DeployMainnet \
#     --rpc-url $BASE_MAINNET_RPC \
#     --broadcast \
#     --verify \
#     --etherscan-api-key $BASESCAN_API_KEY
#
# Verification after deployment:
#   source .env
#   forge script script/VerifyContracts.s.sol:VerifyContracts \
#     --rpc-url $BASE_SEPOLIA_RPC
#
# ═══════════════════════════════════════════════════════════════════════════════
